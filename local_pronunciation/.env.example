SUPABASE_SERVICE_ROLE_KEY=PASTE_SERVICE_ROLE_KEY_HERE

# Desktop 8GB RAM / GTX 1050 Ti 4GB / i3-10100: CPU baseline (safe memory profile)
WHISPER_MODEL=small.en
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
# OpenPronounce optional beta; enable_openpronounce.bat updates these when installed.
OPENPRONOUNCE_ENABLED=0
OPENPRONOUNCE_DEVICE=cpu
OMP_NUM_THREADS=2
MKL_NUM_THREADS=2
TOKENIZERS_PARALLELISM=false
AUTO_PASS_SCORE=70
MAX_AUDIO_BYTES=2097152

# Không tranh tài nguyên với công việc khác
PAUSE_ON_BATTERY=1
CPU_BUSY_LIMIT=85
GPU_BUSY_LIMIT=70
MODEL_IDLE_UNLOAD_SECONDS=900
JOB_RETENTION_SECONDS=1800

ALLOWED_ORIGINS=https://lddenglish.page,https://www.lddenglish.page,https://duong2711.github.io,http://127.0.0.1:3000,http://localhost:3000
